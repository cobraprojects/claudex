#!/bin/sh
set -eu

base_url="http://127.0.0.1:18765"
proxy="$HOME/.local/share/claudex/bin/claude-code-proxy"
label="com.cobraprojects.claudex-proxy"

proxy_ready() {
  curl -fsS --max-time 2 "$base_url/healthz" >/dev/null 2>&1
}

start_proxy() {
  case "$(uname -s)" in
    Darwin)
      launchctl kickstart -k "gui/$(id -u)/$label" >/dev/null 2>&1 || true
      ;;
    Linux)
      if command -v systemctl >/dev/null 2>&1 \
        && systemctl --user show-environment >/dev/null 2>&1; then
        systemctl --user restart claudex-proxy.service >/dev/null 2>&1 || true
      else
        mkdir -p "$HOME/.local/state/claudex-proxy"
        nohup "$proxy" serve --no-monitor \
          >>"$HOME/.local/state/claudex-proxy/service.log" 2>&1 &
      fi
      ;;
  esac
}

if ! proxy_ready; then
  start_proxy
  attempt=0
  while ! proxy_ready; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 20 ]; then
      echo "claudex: the local proxy did not start" >&2
      exit 1
    fi
    sleep 0.25
  done
fi

models="$(curl -fsS --max-time 3 "$base_url/v1/models?limit=1000")"
for model in \
  claude-gpt-5.4 \
  claude-gpt-5.5 \
  claude-gpt-5.6-luna \
  claude-gpt-5.6-terra \
  claude-gpt-5.6-sol
do
  case "$models" in
    *"\"id\":\"$model\""*) ;;
    *)
      echo "claudex: GPT model discovery is unavailable; reinstall with:" >&2
      echo "curl -fsSL https://raw.githubusercontent.com/cobraprojects/claudex/main/install.sh | bash" >&2
      exit 1
      ;;
  esac
done

if command -v claude >/dev/null 2>&1; then
  claude_bin="$(command -v claude)"
elif [ -x "$HOME/.local/bin/claude" ]; then
  claude_bin="$HOME/.local/bin/claude"
else
  echo "claudex: Claude Code is not installed" >&2
  exit 1
fi

capabilities="effort,xhigh_effort,max_effort,thinking,adaptive_thinking,interleaved_thinking"
session_settings=$(printf '%s' \
  '{"enableWorkflows":true,"env":{"ANTHROPIC_API_KEY":"","ANTHROPIC_BASE_URL":"http://127.0.0.1:18765","ANTHROPIC_AUTH_TOKEN":"unused","ANTHROPIC_MODEL":"fable","CLAUDE_CODE_AUTO_COMPACT_WINDOW":"272000","CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY":"0","CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK":"1","CLAUDE_CODE_WORKFLOWS":"1"}}')

# Keep Claude's default ~/.claude directory so existing MCPs, skills, plugins,
# settings, projects, and history remain available. Command-line settings have
# higher priority than user settings and only shadow the proxy connection keys
# for this Claudex process.
exec env \
  ANTHROPIC_API_KEY= \
  ANTHROPIC_BASE_URL="$base_url" \
  ANTHROPIC_AUTH_TOKEN=unused \
  ANTHROPIC_MODEL=fable \
  CLAUDE_CODE_AUTO_COMPACT_WINDOW=272000 \
  CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=0 \
  CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1 \
  CLAUDE_CODE_WORKFLOWS=1 \
  ANTHROPIC_DEFAULT_FABLE_MODEL=claude-gpt-5.6-sol \
  ANTHROPIC_DEFAULT_FABLE_MODEL_NAME="GPT-5.6 Sol" \
  ANTHROPIC_DEFAULT_FABLE_MODEL_DESCRIPTION="Maximum-capability GPT model via Codex" \
  ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES="$capabilities" \
  ANTHROPIC_DEFAULT_OPUS_MODEL=claude-gpt-5.6-terra \
  ANTHROPIC_DEFAULT_OPUS_MODEL_NAME="GPT-5.6 Terra" \
  ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION="High-capability GPT model via Codex" \
  ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES="$capabilities" \
  ANTHROPIC_DEFAULT_SONNET_MODEL=claude-gpt-5.6-luna \
  ANTHROPIC_DEFAULT_SONNET_MODEL_NAME="GPT-5.6 Luna" \
  ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION="Fast GPT model via Codex" \
  ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES="$capabilities" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-gpt-5.5 \
  ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME="GPT-5.5" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION="GPT-5.5 via Codex" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES="$capabilities" \
  ANTHROPIC_CUSTOM_MODEL_OPTION=claude-gpt-5.4 \
  ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="GPT-5.4" \
  ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="GPT-5.4 via Codex" \
  ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES="$capabilities" \
  "$claude_bin" --settings "$session_settings" --dangerously-skip-permissions "$@"
