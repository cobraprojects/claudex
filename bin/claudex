#!/bin/sh
set -eu

base_url="${CLAUDEX_BASE_URL:-http://127.0.0.1:18765}"
proxy="$HOME/.local/share/claudex/bin/claude-code-proxy"
plugin="$HOME/.local/share/claudex/plugin"
label="com.cobraprojects.claudex-proxy"

proxy_ready() {
  curl -fsS --max-time 2 "$base_url/healthz" >/dev/null 2>&1
}

start_proxy() {
  case "$(uname -s)" in
    Darwin)
      launchctl kickstart -k "gui/$(id -u)/$label" >/dev/null 2>&1 || true
      ;;
    Linux)
      if command -v systemctl >/dev/null 2>&1 \
        && systemctl --user show-environment >/dev/null 2>&1; then
        systemctl --user restart claudex-proxy.service >/dev/null 2>&1 || true
      else
        mkdir -p "$HOME/.local/state/claudex-proxy"
        nohup "$proxy" serve --no-monitor \
          >>"$HOME/.local/state/claudex-proxy/service.log" 2>&1 &
      fi
      ;;
  esac
}

if ! proxy_ready; then
  start_proxy
  attempt=0
  while ! proxy_ready; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 20 ]; then
      echo "claudex: the local proxy did not start" >&2
      exit 1
    fi
    sleep 0.25
  done
fi

models="$(curl -fsS --max-time 3 "$base_url/v1/models?limit=1000")"
model_ids="$(printf '%s\n' "$models" \
  | tr '{' '\n' \
  | sed -n 's/.*"id":"\(claude-gpt-[a-z0-9.-]*\)".*/\1/p' \
  | sed '/-fast$/d' \
  | sort -u)"
[ -n "$model_ids" ] || {
  echo "claudex: the proxy did not advertise any Codex GPT models" >&2
  exit 1
}

if command -v claude >/dev/null 2>&1; then
  claude_bin="$(command -v claude)"
elif [ -x "$HOME/.local/bin/claude" ]; then
  claude_bin="$HOME/.local/bin/claude"
else
  echo "claudex: Claude Code is not installed" >&2
  exit 1
fi

saved_model=""
if [ -f "$HOME/.claude/settings.json" ]; then
  saved_model="$(tr ',' '\n' <"$HOME/.claude/settings.json" \
    | sed -n 's/.*"model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    | head -n 1)"
fi

if [ -n "$saved_model" ] \
  && printf '%s\n' "$model_ids" | grep -Fxq "$saved_model"; then
  startup_model="$saved_model"
else
  startup_model="claude-gpt-6-astra"
  if ! printf '%s\n' "$model_ids" | grep -Fxq "$startup_model"; then
    startup_model="claude-gpt-5.6-sol"
  fi
  if ! printf '%s\n' "$model_ids" | grep -Fxq "$startup_model"; then
    startup_model="$(printf '%s\n' "$model_ids" | tail -n 1)"
  fi
fi

model_options=""
while IFS= read -r model; do
  label="$(printf '%s\n' "${model#claude-}" | awk -F- '{
    label = toupper($1) "-" $2
    for (i = 3; i <= NF; i++) {
      label = label " " toupper(substr($i, 1, 1)) substr($i, 2)
    }
    print label
  }')"
  option="{\"model\":\"$model\",\"label\":\"$label\",\"description\":\"Codex subscription\",\"behavesAs\":\"fable\"}"
  if [ -n "$model_options" ]; then
    model_options="$model_options,$option"
  else
    model_options="$option"
  fi
done <<EOF
$model_ids
EOF

session_settings="$(printf '%s' \
  "{\"enableWorkflows\":true,\"modelPicker\":{\"replaceBuiltInOptions\":true,\"options\":[$model_options]},\"env\":{\"ANTHROPIC_BASE_URL\":\"$base_url\",\"ANTHROPIC_AUTH_TOKEN\":\"unused\",\"ANTHROPIC_MODEL\":\"$startup_model\",\"CLAUDE_CODE_AUTO_COMPACT_WINDOW\":\"272000\",\"CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY\":\"0\",\"CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK\":\"1\",\"CLAUDE_CODE_WORKFLOWS\":\"1\"}}")"

# An empty API key still counts as configured in recent Claude Code versions.
unset ANTHROPIC_API_KEY

# Keep Claude's default ~/.claude directory so existing MCPs, skills, plugins,
# settings, projects, and history remain available. Command-line settings have
# higher priority than user settings and only shadow the proxy connection keys
# for this Claudex process.
exec env \
  ANTHROPIC_BASE_URL="$base_url" \
  ANTHROPIC_AUTH_TOKEN=unused \
  ANTHROPIC_MODEL="$startup_model" \
  CLAUDE_CODE_AUTO_COMPACT_WINDOW=272000 \
  CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=0 \
  CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1 \
  CLAUDE_CODE_WORKFLOWS=1 \
  "$claude_bin" --plugin-dir "$plugin" --settings "$session_settings" \
  --dangerously-skip-permissions "$@"
