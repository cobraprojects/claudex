index 0000000..6241acd
--- /dev/null
+++ b/src/providers/codex/models.rs
@@ -0,0 +1,686 @@
+//! The authenticated Codex catalog is the source of model IDs and lane metadata.
+use std::sync::{LazyLock, RwLock};
+use std::time::{Duration, Instant};
+
+use anyhow::{Result, ensure};
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value, json};
+use tokio::sync::Mutex;
+
+use super::auth::{
+    constants::CODEX_API_ENDPOINT,
+    manager::CodexAuthManager,
+    token_store::{StoredAuth, file_store},
+};
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+pub struct Model {
+    pub slug: String,
+    #[serde(default)]
+    pub priority: i32,
+    #[serde(default)]
+    pub use_responses_lite: bool,
+    pub visibility: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub default_reasoning_level: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub supported_reasoning_levels: Option<Vec<ReasoningLevel>>,
+    #[serde(flatten)]
+    pub metadata: Map<String, Value>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+pub struct ReasoningLevel {
+    pub effort: String,
+    #[serde(default)]
+    pub description: String,
+}
+
+// Public capabilities only: model-owned prompts and internal tool configuration
+// are not part of the compatibility API.
+const PUBLIC_METADATA: &[&str] = &[
+    "display_name",
+    "description",
+    "context_window",
+    "max_context_window",
+    "auto_compact_token_limit",
+    "effective_context_window_percent",
+    "input_modalities",
+    "supports_image_detail_original",
+    "supports_reasoning_summary_parameter",
+    "default_reasoning_summary",
+    "supports_reasoning_effort_updates",
+    "support_verbosity",
+    "default_verbosity",
+    "supported_in_api",
+    "supports_search_tool",
+    "web_search_tool_type",
+    "service_tiers",
+    "default_service_tier",
+    "additional_speed_tiers",
+    "upgrade",
+    "model_specialty",
+];
+
+impl Model {
+    fn resolve_effort(&self, requested: Option<&str>) -> Result<Option<String>> {
+        let effort = requested.or(self.default_reasoning_level.as_deref());
+        if let Some(effort) = effort {
+            ensure!(!effort.is_empty(), "Reasoning effort must not be empty");
+            if let Some(levels) = &self.supported_reasoning_levels {
+                ensure!(
+                    levels.iter().any(|level| level.effort == effort),
+                    "Model '{}' does not support reasoning effort '{}'. Supported: {}",
+                    self.slug,
+                    effort,
+                    levels
+                        .iter()
+                        .map(|level| level.effort.as_str())
+                        .collect::<Vec<_>>()
+                        .join(", ")
+                );
+            }
+        }
+        Ok(effort.map(str::to_owned))
+    }
+
+    fn listing(&self, id: &str, is_default: bool) -> Value {
+        let mut entry = serde_json::to_value(self).unwrap();
+        entry["id"] = json!(id);
+        entry["type"] = json!("model");
+        entry["object"] = json!("model");
+        entry["owned_by"] = json!("openai");
+        entry["is_default"] = json!(is_default);
+        if id.starts_with("claude-") {
+            entry["behaves_as"] = json!("claude-fable-5-1");
+        }
+        // Codex's preset API calls these "efforts"; expose both spellings for clients.
+        if let Some(levels) = &self.supported_reasoning_levels {
+            entry["supported_reasoning_efforts"] = json!(levels);
+        }
+        if let Some(default) = &self.default_reasoning_level {
+            entry["default_reasoning_effort"] = json!(default);
+        }
+        if entry.get("display_name").is_none_or(Value::is_null) {
+            entry["display_name"] = json!(self.slug);
+        }
+        entry
+    }
+}
+
+#[derive(Default, Deserialize)]
+struct Catalog {
+    models: Vec<Model>,
+}
+
+impl Catalog {
+    fn parse(body: &str) -> Result<Self> {
+        let mut catalog: Self = serde_json::from_str(body)?;
+        catalog.models.retain(|model| {
+            model.slug.starts_with("gpt-")
+                && model
+                    .slug
+                    .bytes()
+                    .all(|c| c.is_ascii_alphanumeric() || b".-_".contains(&c))
+        });
+        for model in &mut catalog.models {
+            model
+                .metadata
+                .retain(|key, _| PUBLIC_METADATA.contains(&key.as_str()));
+            model.resolve_effort(None)?;
+        }
+        catalog
+            .models
+            .sort_by(|a, b| a.priority.cmp(&b.priority).then(a.slug.cmp(&b.slug)));
+        catalog.models.dedup_by(|a, b| a.slug == b.slug);
+        ensure!(
+            catalog
+                .models
+                .iter()
+                .any(|model| model.visibility == "list"),
+            "Codex did not return any visible GPT models"
+        );
+        Ok(catalog)
+    }
+
+    fn default_model(&self) -> Option<&str> {
+        self.models
+            .iter()
+            .find(|model| model.visibility == "list")
+            .map(|model| model.slug.as_str())
+    }
+}
+
+struct CachedCatalog {
+    access: String,
+    fetched_at: Instant,
+    catalog: Catalog,
+}
+
+static CATALOG: LazyLock<RwLock<Option<CachedCatalog>>> = LazyLock::new(|| RwLock::new(None));
+static REFRESH: Mutex<()> = Mutex::const_new(());
+
+pub async fn refresh(force: bool) -> Result<()> {
+    let _guard = REFRESH.lock().await;
+    let manager = CodexAuthManager::new(file_store());
+    let mut auth = match manager.get_auth().await {
+        Ok(auth) => auth,
+        Err(error) => {
+            *CATALOG.write().unwrap() = None;
+            return Err(error);
+        }
+    };
+    {
+        let cache = CATALOG.read().unwrap();
+        if !force
+            && cache.as_ref().is_some_and(|cache| {
+                cache.access == auth.access && cache.fetched_at.elapsed() < Duration::from_secs(300)
+            })
+        {
+            return Ok(());
+        }
+    }
+    // Drop the old account's catalog before fetching; replace same-account catalogs atomically.
+    {
+        let mut cache = CATALOG.write().unwrap();
+        if cache
+            .as_ref()
+            .is_some_and(|cache| cache.access != auth.access)
+        {
+            *cache = None;
+        }
+    }
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(30))
+        .build()?;
+    let base = crate::config::codex_base_url(CODEX_API_ENDPOINT);
+    let endpoint = format!(
+        "{}/models",
+        base.trim_end_matches('/').trim_end_matches("/responses")
+    );
+    let version = protocol_version(&client).await?;
+    let mut response = fetch(&client, &endpoint, &auth, &version).await?;
+    if response.status() == reqwest::StatusCode::UNAUTHORIZED {
+        auth = manager.force_refresh(&auth.access).await?;
+        response = fetch(&client, &endpoint, &auth, &version).await?;
+    }
+    if response.status() == reqwest::StatusCode::UNAUTHORIZED {
+        manager.store.clear_auth()?;
+        *CATALOG.write().unwrap() = None;
+        return Err(super::auth::manager::AuthenticationRequired.into());
+    }
+    let catalog = Catalog::parse(&response.error_for_status()?.text().await?)?;
+    *CATALOG.write().unwrap() = Some(CachedCatalog {
+        access: auth.access,
+        fetched_at: Instant::now(),
+        catalog,
+    });
+    Ok(())
+}
+
+// The catalog filters by Codex protocol version, not this proxy's package version.
+// Read OpenAI's published release metadata; no local Codex installation is used.
+async fn protocol_version(client: &reqwest::Client) -> Result<String> {
+    #[derive(Deserialize)]
+    struct Release {
+        tag_name: String,
+    }
+    let release: Release = client
+        .get("https://api.github.com/repos/openai/codex/releases/latest")
+        .header("User-Agent", "claudex")
+        .send()
+        .await?
+        .error_for_status()?
+        .json()
+        .await?;
+    let version = release
+        .tag_name
+        .strip_prefix("rust-v")
+        .ok_or_else(|| anyhow::anyhow!("Invalid OpenAI Codex release version"))?;
+    ensure!(
+        version.split('.').count() == 3
+            && version
+                .split('.')
+                .all(|part| !part.is_empty() && part.bytes().all(|c| c.is_ascii_digit())),
+        "Invalid OpenAI Codex release version"
+    );
+    Ok(version.to_owned())
+}
+
+async fn fetch(
+    client: &reqwest::Client,
+    endpoint: &str,
+    auth: &StoredAuth,
+    version: &str,
+) -> Result<reqwest::Response> {
+    let mut request = client
+        .get(endpoint)
+        .query(&[("client_version", version)])
+        .bearer_auth(&auth.access)
+        .header("originator", "codex_cli_rs")
+        .header(
+            "User-Agent",
+            format!("claudex/{}", env!("CARGO_PKG_VERSION")),
+        );
+    if let Some(account) = &auth.account_id {
+        request = request.header("ChatGPT-Account-Id", account);
+    }
+    Ok(request.send().await?)
+}
+
+pub fn advertised_models() -> Vec<String> {
+    CATALOG
+        .read()
+        .unwrap()
+        .as_ref()
+        .map(|cache| {
+            cache
+                .catalog
+                .models
+                .iter()
+                .filter(|model| model.visibility == "list")
+                .map(|model| model.slug.clone())
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+pub fn listing(model: &str, id: &str) -> Option<Value> {
+    let cache = CATALOG.read().unwrap();
+    let catalog = &cache.as_ref()?.catalog;
+    let entry = catalog.models.iter().find(|entry| entry.slug == model)?;
+    Some(entry.listing(id, catalog.default_model() == Some(model)))
+}
+
+pub fn resolve_effort(model: &str, effort: Option<&str>) -> Result<Option<String>> {
+    let cache = CATALOG.read().unwrap();
+    if let Some(entry) = cache.as_ref().and_then(|cache| {
+        cache
+            .catalog
+            .models
+            .iter()
+            .find(|entry| entry.slug == model)
+    }) {
+        return entry.resolve_effort(effort);
+    }
+    Ok(effort.map(str::to_owned))
+}
+
+pub fn supports_reasoning_summary(model: &str) -> bool {
+    let cache = CATALOG.read().unwrap();
+    cache
+        .as_ref()
+        .and_then(|cache| {
+            cache
+                .catalog
+                .models
+                .iter()
+                .find(|entry| entry.slug == model)
+        })
+        .and_then(|entry| entry.metadata.get("supports_reasoning_summary_parameter"))
+        .and_then(Value::as_bool)
+        .unwrap_or(true)
+}
+
+pub fn contains(model: &str) -> bool {
+    CATALOG
+        .read()
+        .unwrap()
+        .as_ref()
+        .is_some_and(|cache| cache.catalog.models.iter().any(|entry| entry.slug == model))
+}
+
+pub fn uses_responses_lite(model: &str) -> bool {
+    CATALOG.read().unwrap().as_ref().is_some_and(|cache| {
+        cache
+            .catalog
+            .models
+            .iter()
+            .any(|entry| entry.slug == model && entry.use_responses_lite)
+    })
+}
+
+pub fn default_model() -> String {
+    CATALOG
+        .read()
+        .unwrap()
+        .as_ref()
+        .and_then(|cache| cache.catalog.default_model().map(str::to_owned))
+        .unwrap_or_default()
+}
+
+pub fn full_lane_model(model: &str) -> String {
+    let cache = CATALOG.read().unwrap();
+    let Some(cache) = cache.as_ref() else {
+        return model.to_owned();
+    };
+    if cache
+        .catalog
+        .models
+        .iter()
+        .any(|entry| entry.slug == model && entry.use_responses_lite)
+    {
+        if let Some(entry) = cache
+            .catalog
+            .models
+            .iter()
+            .find(|entry| entry.visibility == "list" && !entry.use_responses_lite)
+        {
+            return entry.slug.clone();
+        }
+    }
+    model.to_owned()
+}
+
