diff --git a/src/providers/codex/models.rs b/src/providers/codex/models.rs
new file mode 100644
index 0000000..c03e715
--- /dev/null
+++ b/src/providers/codex/models.rs
@@ -0,0 +1,379 @@
+//! The authenticated Codex catalog is the source of model IDs and lane metadata.
+use std::sync::{LazyLock, RwLock};
+use std::time::{Duration, Instant};
+
+use anyhow::{Result, ensure};
+use serde::Deserialize;
+use tokio::sync::Mutex;
+
+use super::auth::{
+    constants::CODEX_API_ENDPOINT,
+    manager::CodexAuthManager,
+    token_store::{StoredAuth, file_store},
+};
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct Model {
+    pub slug: String,
+    #[serde(default)]
+    pub priority: i32,
+    #[serde(default)]
+    pub use_responses_lite: bool,
+    pub visibility: String,
+}
+
+#[derive(Default, Deserialize)]
+struct Catalog {
+    models: Vec<Model>,
+}
+
+impl Catalog {
+    fn parse(body: &str) -> Result<Self> {
+        let mut catalog: Self = serde_json::from_str(body)?;
+        catalog.models.retain(|model| {
+            model.slug.starts_with("gpt-")
+                && model
+                    .slug
+                    .bytes()
+                    .all(|c| c.is_ascii_alphanumeric() || b".-_".contains(&c))
+        });
+        catalog
+            .models
+            .sort_by(|a, b| a.priority.cmp(&b.priority).then(a.slug.cmp(&b.slug)));
+        catalog.models.dedup_by(|a, b| a.slug == b.slug);
+        ensure!(
+            catalog
+                .models
+                .iter()
+                .any(|model| model.visibility == "list"),
+            "Codex did not return any visible GPT models"
+        );
+        Ok(catalog)
+    }
+
+    fn default_model(&self) -> Option<&str> {
+        self.models
+            .iter()
+            .find(|model| model.visibility == "list")
+            .map(|model| model.slug.as_str())
+    }
+}
+
+struct CachedCatalog {
+    access: String,
+    fetched_at: Instant,
+    catalog: Catalog,
+}
+
+static CATALOG: LazyLock<RwLock<Option<CachedCatalog>>> = LazyLock::new(|| RwLock::new(None));
+static REFRESH: Mutex<()> = Mutex::const_new(());
+
+pub async fn refresh(force: bool) -> Result<()> {
+    let _guard = REFRESH.lock().await;
+    let manager = CodexAuthManager::new(file_store());
+    let mut auth = match manager.get_auth().await {
+        Ok(auth) => auth,
+        Err(error) => {
+            *CATALOG.write().unwrap() = None;
+            return Err(error);
+        }
+    };
+    {
+        let cache = CATALOG.read().unwrap();
+        if !force
+            && cache.as_ref().is_some_and(|cache| {
+                cache.access == auth.access && cache.fetched_at.elapsed() < Duration::from_secs(300)
+            })
+        {
+            return Ok(());
+        }
+    }
+    // Drop the old account's catalog before fetching; replace same-account catalogs atomically.
+    {
+        let mut cache = CATALOG.write().unwrap();
+        if cache
+            .as_ref()
+            .is_some_and(|cache| cache.access != auth.access)
+        {
+            *cache = None;
+        }
+    }
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(30))
+        .build()?;
+    let base = crate::config::codex_base_url(CODEX_API_ENDPOINT);
+    let endpoint = format!(
+        "{}/models",
+        base.trim_end_matches('/').trim_end_matches("/responses")
+    );
+    let version = protocol_version(&client).await?;
+    let mut response = fetch(&client, &endpoint, &auth, &version).await?;
+    if response.status() == reqwest::StatusCode::UNAUTHORIZED {
+        auth = manager.force_refresh(&auth.access).await?;
+        response = fetch(&client, &endpoint, &auth, &version).await?;
+    }
+    let catalog = Catalog::parse(&response.error_for_status()?.text().await?)?;
+    *CATALOG.write().unwrap() = Some(CachedCatalog {
+        access: auth.access,
+        fetched_at: Instant::now(),
+        catalog,
+    });
+    Ok(())
+}
+
+// The catalog filters by Codex protocol version, not this proxy's package version.
+// Read OpenAI's published release metadata; no local Codex installation is used.
+async fn protocol_version(client: &reqwest::Client) -> Result<String> {
+    #[derive(Deserialize)]
+    struct Release {
+        tag_name: String,
+    }
+    let release: Release = client
+        .get("https://api.github.com/repos/openai/codex/releases/latest")
+        .header("User-Agent", "claudex")
+        .send()
+        .await?
+        .error_for_status()?
+        .json()
+        .await?;
+    let version = release
+        .tag_name
+        .strip_prefix("rust-v")
+        .ok_or_else(|| anyhow::anyhow!("Invalid OpenAI Codex release version"))?;
+    ensure!(
+        version.split('.').count() == 3
+            && version
+                .split('.')
+                .all(|part| !part.is_empty() && part.bytes().all(|c| c.is_ascii_digit())),
+        "Invalid OpenAI Codex release version"
+    );
+    Ok(version.to_owned())
+}
+
+async fn fetch(
+    client: &reqwest::Client,
+    endpoint: &str,
+    auth: &StoredAuth,
+    version: &str,
+) -> Result<reqwest::Response> {
+    let mut request = client
+        .get(endpoint)
+        .query(&[("client_version", version)])
+        .bearer_auth(&auth.access)
+        .header("originator", "codex_cli_rs")
+        .header(
+            "User-Agent",
+            format!("claudex/{}", env!("CARGO_PKG_VERSION")),
+        );
+    if let Some(account) = &auth.account_id {
+        request = request.header("ChatGPT-Account-Id", account);
+    }
+    Ok(request.send().await?)
+}
+
+pub fn advertised_models() -> Vec<String> {
+    CATALOG
+        .read()
+        .unwrap()
+        .as_ref()
+        .map(|cache| {
+            cache
+                .catalog
+                .models
+                .iter()
+                .filter(|model| model.visibility == "list")
+                .map(|model| model.slug.clone())
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+pub fn contains(model: &str) -> bool {
+    CATALOG
+        .read()
+        .unwrap()
+        .as_ref()
+        .is_some_and(|cache| cache.catalog.models.iter().any(|entry| entry.slug == model))
+}
+
+pub fn uses_responses_lite(model: &str) -> bool {
+    CATALOG.read().unwrap().as_ref().is_some_and(|cache| {
+        cache
+            .catalog
+            .models
+            .iter()
+            .any(|entry| entry.slug == model && entry.use_responses_lite)
+    })
+}
+
+pub fn default_model() -> String {
+    CATALOG
+        .read()
+        .unwrap()
+        .as_ref()
+        .and_then(|cache| cache.catalog.default_model().map(str::to_owned))
+        .unwrap_or_default()
+}
+
+pub fn full_lane_model(model: &str) -> String {
+    let cache = CATALOG.read().unwrap();
+    let Some(cache) = cache.as_ref() else {
+        return model.to_owned();
+    };
+    if cache
+        .catalog
+        .models
+        .iter()
+        .any(|entry| entry.slug == model && entry.use_responses_lite)
+    {
+        if let Some(entry) = cache
+            .catalog
+            .models
+            .iter()
+            .find(|entry| entry.visibility == "list" && !entry.use_responses_lite)
+        {
+            return entry.slug.clone();
+        }
+    }
+    model.to_owned()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use axum::{Json, Router, routing::get};
+    use serde_json::json;
+
+    #[tokio::test]
+    async fn discovery_catalog_routes_future_models_and_replaces_removed_models() {
+        let body = json!({"models": [
+            {"slug": "gpt-future-test", "visibility": "list", "priority": 0, "use_responses_lite": true},
+            {"slug": "gpt-full-test", "visibility": "list", "priority": 1},
+            {"slug": "gpt-hidden-test", "visibility": "hide", "priority": -1}
+        ]});
+        let app = Router::new().route(
+            "/models",
+            get(move |headers: http::HeaderMap| {
+                let body = body.clone();
+                async move {
+                    assert_eq!(headers["authorization"], "Bearer test-token");
+                    assert_eq!(headers["chatgpt-account-id"], "test-account");
+                    Json(body)
+                }
+            }),
+        );
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let endpoint = format!("http://{}/models", listener.local_addr().unwrap());
+        let server = tokio::spawn(async move {
+            axum::serve(listener, app).await.unwrap();
+        });
+        let auth = StoredAuth {
+            access: "test-token".into(),
+            refresh: String::new(),
+            expires: u64::MAX,
+            account_id: Some("test-account".into()),
+        };
+        let response = fetch(&reqwest::Client::new(), &endpoint, &auth, "0.1.0")
+            .await
+            .unwrap();
+        let catalog = Catalog::parse(&response.text().await.unwrap()).unwrap();
+        *CATALOG.write().unwrap() = Some(CachedCatalog {
+            access: auth.access,
+            fetched_at: Instant::now(),
+            catalog,
+        });
+        let registry = crate::registry::Registry::new(crate::config::AliasProvider::Codex);
+        let translated = super::super::chat_completions::request::translate_request(json!({
+            "model": "gpt-future-test", "messages": [{"role": "user", "content": "hello"}]
+        }))
+        .unwrap();
+        assert_eq!(translated.model, "gpt-future-test");
+        assert!(translated.use_responses_lite);
+        assert!(
+            super::super::native::validate_native_request_model(&json!({
+                "model": "gpt-future-test", "input": "hello"
+            }))
+            .is_ok()
+        );
+        let provider: std::sync::Arc<dyn crate::provider::Provider> =
+            std::sync::Arc::new(super::super::CodexProvider::new());
+        let fixture_registry = crate::registry::Registry::from_providers(
+            crate::config::AliasProvider::Codex,
+            [provider],
+        );
+        use http_body_util::BodyExt;
+        use tower::ServiceExt;
+        let response = crate::server::app(std::sync::Arc::new(fixture_registry))
+            .oneshot(
+                http::Request::builder()
+                    .uri("/v1/models")
+                    .body(axum::body::Body::empty())
+                    .unwrap(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(response.status(), http::StatusCode::OK);
+        let body: serde_json::Value =
+            serde_json::from_slice(&response.into_body().collect().await.unwrap().to_bytes())
+                .unwrap();
+        assert!(body["data"].as_array().unwrap().iter().any(|entry|
+            entry["id"] == "claude-gpt-future-test" && entry["is_default"] == true));
+
+        assert_eq!(default_model(), "gpt-future-test");
+        assert_eq!(advertised_models(), ["gpt-future-test", "gpt-full-test"]);
+        assert!(
+            super::super::translate::model_allowlist::assert_allowed_model("gpt-future-test")
+                .is_ok()
+        );
+        assert!(uses_responses_lite("gpt-future-test"));
+        assert!(!uses_responses_lite("gpt-full-test"));
+        assert_eq!(full_lane_model("gpt-future-test"), "gpt-full-test");
+        assert_eq!(
+            registry
+                .provider_for_model("claude-gpt-future-test", None)
+                .unwrap()
+                .name(),
+            "codex"
+        );
+        assert!(
+            registry
+                .all_supported_models()
+                .contains(&("gpt-future-test".into(), "codex".into()))
+        );
+        let catalog =
+            Catalog::parse(r#"{"models":[{"slug":"gpt-next-test","visibility":"list"}]}"#).unwrap();
+        CATALOG.write().unwrap().as_mut().unwrap().catalog = catalog;
+        assert_eq!(
+            registry
+                .supported_models_for("codex")
+                .iter()
+                .filter(|id| id.starts_with("gpt-"))
+                .collect::<Vec<_>>(),
+            [&"gpt-next-test".to_string()]
+        );
+        assert!(!contains("gpt-future-test"));
+        assert!(
+            super::super::translate::model_allowlist::assert_allowed_model("gpt-future-test")
+                .is_err()
+        );
+        assert!(
+            registry
+                .provider_for_model("gpt-future-test", None)
+                .is_none()
+        );
+        *CATALOG.write().unwrap() = None;
+        server.abort();
+    }
+
+    #[test]
+    fn discovery_rejects_invalid_and_empty_catalogs() {
+        for body in [
+            r#"{"models":[]}"#,
+            r#"{"models":[{"slug":"gpt-bad\"","visibility":"list"}]}"#,
+            r#"{"models":[{"slug":"gpt-hidden","visibility":"hide"}]}"#,
+            r#"{"data":[]}"#,
+        ] {
+            assert!(Catalog::parse(body).is_err());
+        }
+    }
+}
