+    #[test]
+    fn effort_metadata_distinguishes_missing_from_unsupported() {
+        let catalog = Catalog::parse(
+            r#"{"models":[
+            {"slug":"gpt-legacy","visibility":"list"},
+            {"slug":"gpt-no-reasoning","visibility":"list","supported_reasoning_levels":[]}
+        ]}"#,
