#!/bin/sh
set -u

plugin_root="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
auth="${CLAUDEX_GPT_AUTH:-$plugin_root/scripts/gpt-auth}"

block() {
  printf '{"decision":"block","reason":"%s"}\n' "$1"
}

case "${1:-}" in
  logout)
    if "$auth" logout >/dev/null 2>&1; then
      block "GPT logout succeeded. Run /gpt-login to sign in with another account."
    else
      block "GPT logout failed."
    fi
    ;;
  login)
    if "$auth" login >&2; then
      block "GPT login succeeded."
    else
      block "GPT login failed or timed out. Run claudex to try again."
    fi
    ;;
  *)
    block "Unknown GPT authentication command."
    ;;
esac
